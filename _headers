# Cloudflare Pages headers: same as the "headers" block in vercel.json, plus cache rules.
# Static files only: Functions (/api/*, /os) set their own headers.
# Pages joins the values of every matching rule, so the later rules first remove Cache-Control with "!".

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https:; connect-src 'self' https:; frame-src https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cache-Control: public, max-age=0, must-revalidate

# Fonts never change in place (git history): cache 1 year, immutable.
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Images and video keep their names when replaced (473 in-place edits in git history), so NOT immutable:
# 1 day fresh, then up to 7 days served from cache while Cloudflare/the browser checks for a new copy.
/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpeg
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.avif
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.mp4
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
